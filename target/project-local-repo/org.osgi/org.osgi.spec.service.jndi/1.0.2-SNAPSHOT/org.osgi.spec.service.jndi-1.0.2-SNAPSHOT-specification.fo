                                 <fo:basic-link external-destination="url(https://docs.osgi.org/specification/)">
                                    <fo:inline color="inherit"
                                               font-family="inherit"
                                               letter-spacing="inherit"
                                               hyphenate="inherit">
                                       <fo:inline hyphenate="false">https://docs.osgi.org/specification/</fo:inline>
                                    </fo:inline>
                                 </fo:basic-link>
                              </fo:inline>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                  </fo:list-block>
               </fo:block>
            </fo:block>
         </fo:block>
      </fo:flow>
   </fo:page-sequence>
