      <fo:static-content flow-name="xsl-region-after-first">
         <fo:block font-family="ProductusBook,ArialUnicodeMS"
                   margin-left="0pt"
                   font-size="9pt"
                   line-height="9pt"
                   font-weight="normal"
                   hyphenate="false"
                   letter-spacing="0.03em">
            <fo:table xmlns:d="http://docbook.org/ns/docbook"
                      xmlns:xlink="http://www.w3.org/1999/xlink"
                      table-layout="fixed"
                      width="100%">
               <fo:table-column column-number="1" column-width="proportional-column-width(1)"/>
               <fo:table-column column-number="2" column-width="proportional-column-width(0)"/>
               <fo:table-column column-number="3" column-width="proportional-column-width(1)"/>
               <fo:table-body>
                  <fo:table-row>
                     <fo:table-cell number-columns-spanned="3">
