                                            letter-spacing="inherit"
                                            hyphenate="inherit">
                                    <fo:inline hyphenate="false">https://github.com/osgi/osgi/issues</fo:inline>
                                 </fo:inline>
                              </fo:basic-link>
                           </fo:inline>
                        </fo:block>
                     </fo:block>
